# mf_alert.ini として同じフォルダにコピーして使う（mf_alert.ini は git 管理外）

[settings]
# 今日から何日先までの引き落としをチェックするか
days_ahead = 31
# 引き落とし額に上乗せしておきたい余裕額（円）
margin = 10000
# 銀行残高の取得日時がこの日数より古ければ注意を出す
stale_days = 3

[card_to_bank]
# カード名 = 引き落とし口座の銀行名
# どちらもマネーフォワードの表示名そのまま（「金融機関サービスサイトへ」の前の部分）。
# 全角/半角スペースの違いは無視される。
# ↓は例。実際の引き落とし口座に合わせて書き換えること。
イオンカード = みずほ銀行
エポスカード = 三菱UFJ銀行
三井住友カード (VpassID) = 三菱UFJ銀行
楽天カード = 千鶴 楽天銀行
千鶴 楽天カード = 千鶴 楽天銀行
VIEW CARD = ソニー銀行
TRUST CLUBカード = みずほ銀行
